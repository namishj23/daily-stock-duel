generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

////////////////////////
// USER & AUTH MODELS
////////////////////////

model User {
  id            String   @id @default(cuid())
  name          String?
  email         String?  @unique
  image         String?
  ageConfirmed  Boolean  @default(false)
  role          Role     @default(USER)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  accounts      Account[]
  sessions      Session[]

  predictions   DailyPrediction[]
  rewards       Reward[]
  dailyResults  DailyResult[]

  @@map("users")
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

////////////////////////
// STOCK MASTER
////////////////////////

model Stock {
  id        String   @id @default(cuid())
  symbol    String   @unique
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  predictions   DailyPrediction[]
  aiPredictions AIPrediction[]

  @@map("stocks")
}

////////////////////////
// DAILY USER PREDICTION
////////////////////////

model DailyPrediction {
  id              String    @id @default(cuid())
  userId          String
  stockId         String
  predictedChange Float     @default(0) // User's predicted % change (-20 to +20)
  justification   String?   // Optional analysis text
  contestDate     DateTime
  submittedAt     DateTime  @default(now())

  lockedAt      DateTime?
  paymentStatus PaymentStatus @default(PENDING)
  paymentId     String?

  entryPrice    Float?
  exitPrice     Float?
  percentChange Float?
  isCorrect     Boolean?

  user   User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  stock  Stock @relation(fields: [stockId], references: [id])

  dailyResult DailyResult?

  @@unique([userId, contestDate])
  @@map("daily_predictions")
}

////////////////////////
// AI DAILY PREDICTION
////////////////////////

model AIPrediction {
  id          String   @id @default(cuid())
  stockId     String
  contestDate DateTime
  direction   Direction
  confidence  Int
  reasoning   String
  createdAt   DateTime @default(now())

  stock Stock @relation(fields: [stockId], references: [id])

  @@unique([stockId, contestDate])
  @@map("ai_predictions")
}

////////////////////////
// DAILY RESULT (WINNER)
////////////////////////

model DailyResult {
  id             String   @id @default(cuid())
  contestDate    DateTime @unique
  winnerUserId   String
  predictionId   String   @unique
  percentGain    Float
  createdAt      DateTime @default(now())

  winner     User            @relation(fields: [winnerUserId], references: [id])
  prediction DailyPrediction @relation(fields: [predictionId], references: [id])

  reward Reward?

  @@map("daily_results")
}


////////////////////////
// PAYOUT / REWARD
////////////////////////

model Reward {
  id            String       @id @default(cuid())
  userId        String
  dailyResultId String       @unique
  amount        Int
  status        RewardStatus @default(PENDING)
  paidAt        DateTime?
  createdAt     DateTime     @default(now())

  user        User        @relation(fields: [userId], references: [id])
  dailyResult DailyResult @relation(fields: [dailyResultId], references: [id])

  @@map("rewards")
}

////////////////////////
// PASSWORD RESET TOKEN
////////////////////////

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  used      Boolean  @default(false)

  @@map("password_reset_tokens")
}

////////////////////////
// ENUMS
////////////////////////

enum Direction {
  UP
  DOWN
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

enum RewardStatus {
  PENDING
  PAID
}

enum Role {
  USER
  ADMIN
}
